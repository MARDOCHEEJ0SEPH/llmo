{
  "name": "llmoweb",
  "version": "1.0.0",
  "description": "LLM Optimization (LLMO) - Code implementation examples and tools",
  "main": "index.js",
  "scripts": {
    "validate-all": "node scripts/validate-all-schemas.js",
    "test": "jest --coverage",
    "test:schemas": "node validation/validate-schema.js schema-templates/*.json",
    "test:examples": "node testing/test-all-examples.js",
    "test:compatibility": "node testing/compatibility-test.js",
    "generate:products": "node automation/database-to-schema-example.js",
    "generate:postgres": "node automation/postgres-integration-example.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "llm",
    "optimization",
    "schema",
    "json-ld",
    "seo",
    "ai",
    "machine-learning",
    "semantic-web",
    "structured-data"
  ],
  "author": "LLMO Project",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.0",
    "natural": "^6.10.0",
    "pg": "^8.11.3",
    "schema-dts": "^1.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.17.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "openai": "^4.24.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MARDOCHEEJ0SEPH/llmo"
  },
  "bugs": {
